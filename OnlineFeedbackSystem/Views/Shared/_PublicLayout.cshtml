<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/respondent.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dash-body">
    <div class="public-shell">
        <header class="public-header">
            <div style="display: flex; align-items: center; gap: 20px;">
                <a href="/" class="brand dash-brand" style="border:none; padding:0; margin:0;">
                    <span class="brand-mark">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M3 12h4l2-7 4 14 2-7h6" stroke="#33314B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    Pulse
                </a>
                <a asp-controller="Respondent" asp-action="Index" style="font-size: 13.5px; font-weight: 700; color: var(--ink-soft); text-decoration: none; padding: 6px 12px; border-radius: 999px; background: rgba(0,0,0,0.04);">Surveys</a>
            </div>
            <div class="public-nav-links">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span style="font-size:13.5px; font-weight:700; color:var(--ink-soft);">Hello, @User.Identity.Name</span>
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <a asp-controller="SuperAdminDashboard" asp-action="Dashboard" class="btn btn-secondary btn-sm">SuperAdmin</a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-secondary btn-sm">Dashboard</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dash-panel-link" style="background:none; border:none; cursor:pointer; font-size:13px; font-weight:700; color:var(--coral-dark);">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-secondary btn-sm">Register</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Sign in</a>
                }
            </div>
        </header>

        <main class="public-main">
            @RenderBody()
        </main>

        <footer class="public-footer">
            &copy; 2026 Online Feedback Management System &bull; Powered by Pulse
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

