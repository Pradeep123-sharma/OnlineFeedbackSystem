@inject OnlineFeedbackSystem.Repositories.INotificationsRepository NotificationsRepo
@{
    string activeNav = ViewData["ActiveNav"] as string ?? string.Empty;
    string pageEyebrow = ViewData["PageEyebrow"] as string ?? "Super admin";

    string NavClass(string key) => key == activeNav ? "dash-nav-link active" : "dash-nav-link";

    int? currentUserId = null;
    var idClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
    if (idClaim != null && int.TryParse(idClaim.Value, out int parsedId))
    {
        currentUserId = parsedId;
    }
    int unreadCount = 0;
    try
    {
        unreadCount = NotificationsRepo.GetUnreadCount(currentUserId);
    }
    catch { }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dash-body">

    <!-- Mobile Drawer Overlay -->
    <div class="dash-sidebar-overlay" id="dashSidebarOverlay"></div>

    <div class="dash-shell">

        <!-- ===== Sidebar (SuperAdmin dashboard) ===== -->
        <aside class="dash-sidebar">
            <a href="/" class="brand dash-brand">
                <span class="brand-mark">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M3 12h4l2-7 4 14 2-7h6" stroke="#33314B" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                Pulse <span class="soon-tag" style="background:#EDE5FF; color:var(--grape-dark);">SuperAdmin</span>
            </a>

            <nav class="dash-nav">
                <span class="dash-nav-label">Overview</span>
                <a asp-controller="SuperAdminDashboard" asp-action="Dashboard" class='@NavClass("Dashboard")'>
                    <span class="nav-emoji">&#128200;</span> Dashboard
                </a>

                <span class="dash-nav-label">System configuration</span>
                <a asp-controller="User" asp-action="Index" class='@NavClass("Users")'>
                    <span class="nav-emoji">&#128101;</span> Users
                </a>
                <a asp-controller="Role" asp-action="Index" class='@NavClass("Roles")'>
                    <span class="nav-emoji">&#128273;</span> Roles &amp; Permissions
                </a>
                <a asp-controller="Department" asp-action="Index" class='@NavClass("Departments")'>
                    <span class="nav-emoji">&#127970;</span> Departments
                </a>

                <span class="dash-nav-label">System</span>
                <a asp-controller="Notifications" asp-action="Index" class='@NavClass("Notifications")'>
                    <span class="nav-emoji">&#128276;</span> Notifications
                    <span class="notif-badge-sidebar" style="display:@(unreadCount > 0 ? "inline-flex" : "none"); margin-left:auto; background:#EF4444; color:#ffffff; font-size:10px; font-weight:800; border-radius:999px; min-width:18px; height:18px; padding:0 5px; align-items:center; justify-content:center;">
                        @(unreadCount > 99 ? "99+" : unreadCount.ToString())
                    </span>
                </a>
                <a href="/AuditLogs" class='@NavClass("AuditLogs")'>
                    <span class="nav-emoji">&#128203;</span> Audit Logs
                </a>
                <a asp-controller="Settings" asp-action="Index" class='@NavClass("Settings")'>
                    <span class="nav-emoji">&#9881;</span> Settings
                </a>
            </nav>

            <form asp-controller="Account" asp-action="Logout" method="post" class="dash-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ghost dash-logout-btn">Log out</button>
            </form>
        </aside>

        <!-- ===== Main content ===== -->
        <div class="dash-main">

            <header class="dash-topbar">
                <div class="dash-topbar-title-wrap">
                    <button class="dash-nav-toggle" id="dashNavToggle" aria-label="Toggle navigation" aria-expanded="false">
                        <span></span><span></span><span></span>
                    </button>
                    <div>
                        <span class="eyebrow">@pageEyebrow</span>
                        <h1>@ViewData["PageTitle"]</h1>
                    </div>
                </div>
                <div class="dash-topbar-actions">
                    <a asp-controller="Notifications" asp-action="Index" class="notif-bell-chip" title="Notifications">
                        <span style="font-size:19px; line-height:1;">&#128276;</span>
                        <span class="notif-badge" style="display:@(unreadCount > 0 ? "inline-flex" : "none");">
                            @(unreadCount > 99 ? "99+" : unreadCount.ToString())
                        </span>
                    </a>
                    <div class="dash-user-chip clay-chip-static" title="@(User.Identity?.Name ?? "System Administrator")">
                        <span class="q-emoji">&#128081;</span> @(User.Identity?.Name ?? "System Administrator")
                    </div>
                </div>
            </header>

            @RenderBody()

        </div>
    </div>

    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

