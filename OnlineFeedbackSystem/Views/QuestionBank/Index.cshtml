@model OnlineFeedbackSystem.Models.ViewModels.QuestionBankIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Question Bank — Pulse";
    ViewData["PageTitle"] = "Question bank";
    ViewData["PageEyebrow"] = "Admin / Feedback Management";
    ViewData["ActiveNav"] = "QuestionBank";
}

@section Styles {
    <link rel="stylesheet" href="~/css/questionbank.css" asp-append-version="true" />
    <style>
        .qb-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 24px;
        }
        .qb-filter-select {
            min-width: 170px;
            max-width: 220px;
        }
        .qb-search-input {
            flex: 1;
            min-width: 220px;
        }
        .qb-category-tag {
            font-size: 11.5px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 999px;
            background: #EAEBF7;
            color: var(--ink-soft);
            display: inline-block;
        }
        .qb-options-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 6px;
        }
        .qb-opt-badge {
            font-size: 11px;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 6px;
            padding: 2px 6px;
            color: var(--ink-soft);
            box-shadow: inset 1px 1px 2px rgba(0,0,0,0.05);
        }
    </style>
}

<section class="dash-panel clay-card qb-panel">
    <div class="dash-panel-head">
        <div>
            <h2>Reusable Questions</h2>
            <p class="dash-panel-sub" style="margin-top:4px;">Manage standardized questions across academic, faculty, and service surveys.</p>
        </div>
        <a asp-controller="QuestionBank" asp-action="Create" class="btn btn-primary btn-sm">+ Add question</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="qb-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="field-error" style="margin-bottom: 16px;">@TempData["ErrorMessage"]</div>
    }

    <!-- ===== Search & Filter Bar (Claymorphic Toolbar) ===== -->
    <form method="get" asp-controller="QuestionBank" asp-action="Index" class="qb-filters">
        <div class="clay-search-wrapper">
            <span class="search-icon">&#128269;</span>
            <input type="text" name="search" value="@Model.SearchQuery" placeholder="Search questions..." class="clay-input" />
        </div>

        <select name="category" class="clay-select qb-filter-select" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat" selected="@(Model.SelectedCategory == cat ? "selected" : null)">@cat</option>
            }
        </select>

        <select name="type" class="clay-select qb-filter-select" onchange="this.form.submit()">
            <option value="">All Question Types</option>
            <option value="Rating5" selected="@(Model.SelectedType == "Rating5" ? "selected" : null)">⭐️ 5-Star Rating</option>
            <option value="Rating10" selected="@(Model.SelectedType == "Rating10" ? "selected" : null)">🔟 1-10 Scale</option>
            <option value="SingleChoice" selected="@(Model.SelectedType == "SingleChoice" ? "selected" : null)">🔘 Single Choice</option>
            <option value="MultipleChoice" selected="@(Model.SelectedType == "MultipleChoice" ? "selected" : null)">☑️ Multiple Choice</option>
            <option value="YesNo" selected="@(Model.SelectedType == "YesNo" ? "selected" : null)">⚖️ Yes / No</option>
            <option value="Dropdown" selected="@(Model.SelectedType == "Dropdown" ? "selected" : null)">🔽 Dropdown</option>
            <option value="Text" selected="@(Model.SelectedType == "Text" ? "selected" : null)">📝 Short Text</option>
            <option value="Textarea" selected="@(Model.SelectedType == "Textarea" ? "selected" : null)">📄 Long Comments</option>
        </select>

        <button type="submit" class="btn btn-secondary btn-sm" style="padding:10px 20px;">Filter</button>
        @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedCategory) || !string.IsNullOrEmpty(Model.SelectedType))
        {
            <a asp-controller="QuestionBank" asp-action="Index" class="qb-action-link" style="margin-left: 6px;">Reset</a>
        }
    </form>

    @if (!Model.Questions.Any())
    {
        <div style="text-align: center; padding: 40px 20px;">
            <span style="font-size: 38px; display: block; margin-bottom: 10px;">&#129504;</span>
            <p class="dash-empty">No questions found matching your filter criteria.</p>
            <a asp-controller="QuestionBank" asp-action="Create" class="btn btn-primary btn-sm" style="margin-top: 12px;">Create first question</a>
        </div>
    }
    else
    {
        <table class="dash-table qb-table">
            <thead>
                <tr>
                    <th>Question</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model.Questions)
                {
                    <tr>
                        <td class="qb-question-text">
                            <strong>@q.QuestionText</strong>
                            @if (q.Options != null && q.Options.Any())
                            {
                                <div class="qb-options-preview">
                                    @foreach (var opt in q.Options.Take(4))
                                    {
                                        <span class="qb-opt-badge">@opt</span>
                                    }
                                    @if (q.Options.Count > 4)
                                    {
                                        <span class="qb-opt-badge">+@(q.Options.Count - 4) more</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            @switch (q.QuestionType)
                            {
                                case "Rating5":
                                    <span class="type-pill" style="background:#FFEACC; color:#D97706;">⭐️ 5-Star</span>
                                    break;
                                case "Rating10":
                                    <span class="type-pill" style="background:#E0E7FF; color:#4338CA;">🔟 1–10</span>
                                    break;
                                case "SingleChoice":
                                    <span class="type-pill" style="background:#EDE5FF; color:var(--grape-dark);">🔘 Single choice</span>
                                    break;
                                case "MultipleChoice":
                                    <span class="type-pill" style="background:#D7F7EC; color:var(--mint-dark);">☑️ Multiple choice</span>
                                    break;
                                case "YesNo":
                                    <span class="type-pill" style="background:#FEF3C7; color:#B45309;">⚖️ Yes / No</span>
                                    break;
                                case "Dropdown":
                                    <span class="type-pill" style="background:#E0F2FE; color:var(--sky-dark);">🔽 Dropdown</span>
                                    break;
                                case "Text":
                                    <span class="type-pill" style="background:#F1F5F9; color:#475569;">📝 Short text</span>
                                    break;
                                case "Textarea":
                                    <span class="type-pill" style="background:#F1F5F9; color:#475569;">📄 Long text</span>
                                    break;
                                default:
                                    <span class="type-pill">@q.QuestionType</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="qb-category-tag">@q.Category</span>
                        </td>
                        <td>
                            @if (q.IsActive)
                            {
                                <span class="status-badge status-published">Active</span>
                            }
                            else
                            {
                                <span class="status-badge status-archived">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="qb-actions">
                                <a asp-controller="QuestionBank" asp-action="Edit" asp-route-id="@q.Id" class="qb-action-link">Edit</a>

                                <form asp-controller="QuestionBank" asp-action="ToggleStatus" asp-route-id="@q.Id" method="post" class="qb-inline-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="qb-action-link">
                                        @(q.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>

                                <form asp-controller="QuestionBank" asp-action="Delete" asp-route-id="@q.Id" method="post" class="qb-inline-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="qb-action-link qb-action-danger" onclick="return confirm('Are you sure you want to delete this question?');">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
