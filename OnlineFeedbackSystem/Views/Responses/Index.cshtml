@model OnlineFeedbackSystem.Models.ViewModels.ResponseListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Feedback Responses — Pulse";
    ViewData["PageTitle"] = "Submitted responses";
    ViewData["PageEyebrow"] = "Admin / Review Portal";
    ViewData["ActiveNav"] = "Responses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/responses.css" asp-append-version="true" />
}

<section class="dash-panel clay-card resp-archive-panel">
    <div class="dash-panel-head">
        <div>
            <h2>Responses Archive</h2>
            <p class="dash-panel-sub" style="margin-top:4px;">Browse and inspect individual feedback submissions.</p>
        </div>
    </div>

    <!-- Filter by Form -->
    <form method="get" asp-controller="Responses" asp-action="Index" class="forms-filters">
        <label style="font-size:13.5px; font-weight:700; color:var(--ink-soft); margin:0;">Filter by Form:</label>
        <select name="formId" class="clay-select resp-form-select" onchange="this.form.submit()">
            <option value="">All Feedback Forms</option>
            @foreach (var f in Model.AvailableForms)
            {
                <option value="@f.Id" selected="@(Model.SelectedFormId == f.Id ? "selected" : null)">@f.Title</option>
            }
        </select>
        @if (Model.SelectedFormId.HasValue)
        {
            <a asp-controller="Responses" asp-action="Index" class="dash-panel-link" style="font-size:13px; font-weight:700;">Show all</a>
            <a asp-controller="Analytics" asp-action="Form" asp-route-id="@Model.SelectedFormId.Value" class="btn btn-secondary btn-sm" style="margin-left:auto;">
                📊 View Form Analytics
            </a>
        }
    </form>

    @if (!Model.Responses.Any())
    {
        <div style="text-align: center; padding: 40px 20px;">
            <span style="font-size: 38px; display: block; margin-bottom: 10px;">💬</span>
            <p class="dash-empty">No responses recorded yet for this selection.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Submission Token</th>
                        <th>Form Title</th>
                        <th>Category</th>
                        <th>Respondent</th>
                        <th>Avg Rating</th>
                        <th>Date Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Responses)
                    {
                        <tr>
                            <td>
                                <strong style="font-family:monospace; color:var(--coral-dark);">@r.SubmissionToken</strong>
                            </td>
                            <td>
                                <strong>@r.FormTitle</strong>
                            </td>
                            <td>
                                <span class="badge" style="background:#EAEBF7; color:var(--ink-soft); font-size:11.5px; font-weight:700; padding:3px 10px; border-radius:999px;">@r.Category</span>
                            </td>
                            <td>
                                @if (r.IsAnonymous)
                                {
                                    <span style="color:var(--ink-faint); font-style:italic;">🕶 Anonymous</span>
                                }
                                else
                                {
                                    <span>@r.RespondentName</span>
                                }
                            </td>
                            <td>
                                @if (r.AverageRating.HasValue)
                                {
                                    <span style="font-weight:800; color:#D97706;">⭐️ @r.AverageRating.Value.ToString("0.0")</span>
                                }
                                else
                                {
                                    <span style="color:var(--ink-faint);">&ndash;</span>
                                }
                            </td>
                            <td style="font-size:12.5px; color:var(--ink-soft);">
                                @r.SubmittedAt.ToString("dd MMM yyyy, hh:mm tt")
                            </td>
                            <td>
                                <a asp-controller="Responses" asp-action="Detail" asp-route-id="@r.Id" class="btn btn-secondary btn-sm" style="padding:6px 12px; font-size:12px;">
                                    View Answers &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
