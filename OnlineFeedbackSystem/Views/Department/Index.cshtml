@model IEnumerable<OnlineFeedbackSystem.Models.ViewModels.DepartmentViewModel>

@{
    Layout = "_DashboardLayout";
    ViewData["ActiveNav"] = "Departments";
    ViewData["PageTitle"] = "Departments";
    ViewData["Title"] = "Departments — Pulse";
}

@section Styles {
    <link rel="stylesheet" href="~/css/departments.css" asp-append-version="true" />
    <style>
        .dept-table {
            table-layout: fixed;
            width: 100%;
        }

        .dept-table th:nth-child(1),
        .dept-table td:nth-child(1) { width: 60%; }

        .dept-table th:nth-child(2),
        .dept-table td:nth-child(2) { width: 15%; }

        .dept-table th:nth-child(3),
        .dept-table td:nth-child(3) { width: 25%; }

        .dept-actions-wrap {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }

        .btn-action-edit {
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 12.5px;
            color: var(--sky-dark);
            background: #E0F2FE;
            border: none;
            cursor: pointer;
            padding: 5px 14px;
            border-radius: 999px;
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.15s ease;
        }

        .btn-action-edit:hover {
            background: #BAE6FD;
            color: var(--sky-dark);
        }

        .btn-action-deactivate {
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 12.5px;
            color: var(--coral-dark);
            background: #FEE2E2;
            border: none;
            cursor: pointer;
            padding: 5px 14px;
            border-radius: 999px;
            white-space: nowrap;
            transition: all 0.15s ease;
        }

        .btn-action-deactivate:hover {
            background: #FECACA;
        }

        .btn-action-activate {
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 12.5px;
            color: var(--mint-dark);
            background: #D7F7EC;
            border: none;
            cursor: pointer;
            padding: 5px 14px;
            border-radius: 999px;
            white-space: nowrap;
            transition: all 0.15s ease;
        }

        .btn-action-activate:hover {
            background: #A7F3D0;
        }

        .inline-form { display: inline; }
    </style>
}

<section class="dash-panel clay-card" style="padding: 26px 24px;">
    <div class="dash-panel-head">
        <div>
            <h2>All Departments</h2>
            <p class="dash-panel-sub" style="margin-top:4px;">Manage departments that users and forms are assigned to.</p>
        </div>
        <a asp-controller="Department" asp-action="Create" class="btn btn-primary btn-sm">+ Add Department</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background:#D7F7EC; color:var(--mint-dark); font-weight:700; font-size:13.5px; padding:12px 16px; border-radius:var(--radius-sm); margin-bottom:16px;">
            ✓ @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background:#FEE2E2; color:var(--coral-dark); font-weight:700; font-size:13.5px; padding:12px 16px; border-radius:var(--radius-sm); margin-bottom:16px;">
            @TempData["Error"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background:#D7F7EC; color:var(--mint-dark); font-weight:700; font-size:13.5px; padding:12px 16px; border-radius:var(--radius-sm); margin-bottom:16px;">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div style="text-align: center; padding: 40px 20px;">
            <span style="font-size: 38px; display: block; margin-bottom: 10px;">🏢</span>
            <p class="dash-empty">No departments yet. Add your first one to start assigning users.</p>
            <a asp-controller="Department" asp-action="Create" class="btn btn-primary btn-sm" style="margin-top:12px;">+ Add Department</a>
        </div>
    }
    else
    {
        <table class="dash-table dept-table">
            <thead>
                <tr>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr>
                        <td>
                            <strong style="color:var(--ink);">@dept.DepartmentName</strong>
                        </td>
                        <td>
                            @if (dept.IsActive)
                            {
                                <span class="status-badge status-published">Active</span>
                            }
                            else
                            {
                                <span class="status-badge status-archived">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="dept-actions-wrap">
                                <a asp-controller="Department" asp-action="Edit" asp-route-id="@dept.DepartmentId" class="btn-action-edit">Edit</a>

                                @if (dept.IsActive)
                                {
                                    <form asp-controller="Department" asp-action="Deactivate" asp-route-id="@dept.DepartmentId" method="post" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action-deactivate"
                                                onclick="return confirm('Deactivate @dept.DepartmentName?');">
                                            Deactivate
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Department" asp-action="Activate" asp-route-id="@dept.DepartmentId" method="post" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action-activate">
                                            Activate
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
