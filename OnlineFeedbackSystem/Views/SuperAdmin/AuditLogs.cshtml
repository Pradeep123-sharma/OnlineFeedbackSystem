@model OnlineFeedbackSystem.Models.ViewModels.AuditLogIndexViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Audit Logs — Pulse";
    ViewData["PageTitle"] = "System audit logs";
    ViewData["PageEyebrow"] = "Super admin / Security & compliance";
    ViewData["ActiveNav"] = "AuditLogs";
}

@section Styles {
    <style>
        .audit-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        .audit-stat-card {
            padding: 20px 22px;
            border-radius: var(--radius-md, 18px);
            background: var(--clay, #F2F4FC);
            box-shadow: var(--shadow-out, 6px 6px 14px rgba(166, 175, 195, 0.45), -6px -6px 14px rgba(255, 255, 255, 0.9));
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .audit-stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
            box-shadow: var(--shadow-in);
        }

        .audit-filters-form {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 22px;
        }

        .action-badge {
            font-size: 11.5px;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
        }

        .action-login { background: #D7F7EC; color: #065F46; }
        .action-create { background: #E0F2FE; color: #0369A1; }
        .action-update { background: #FEF3C7; color: #B45309; }
        .action-publish { background: #EDE5FF; color: #5B21B6; }
        .action-close { background: #FFE4E6; color: #BE123C; }
        .action-delete { background: #FEE2E2; color: #B91C1C; }
        .action-default { background: var(--clay-soft, #EAEBF7); color: var(--ink-soft, #55536E); }

        .entity-chip {
            font-size: 11.5px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 6px;
            background: rgba(0, 0, 0, 0.05);
            color: var(--ink, #33314B);
            display: inline-block;
        }

        .user-chip-mini {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .user-avatar-mini {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #FFEACC;
            color: #D97706;
            font-size: 12px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
    </style>
}

<!-- ===== Top Stat Cards ===== -->
<div class="audit-stats-grid">
    <div class="audit-stat-card">
        <div class="audit-stat-icon icon-coral">📜</div>
        <div>
            <div class="dash-stat-num" style="font-size:24px; margin:0;">@Model.TotalLogsCount</div>
            <div class="dash-stat-label" style="font-size:12px;">Total Audit Logs</div>
        </div>
    </div>
    <div class="audit-stat-card">
        <div class="audit-stat-icon icon-mint">⚡</div>
        <div>
            <div class="dash-stat-num" style="font-size:24px; margin:0;">@Model.TodayLogsCount</div>
            <div class="dash-stat-label" style="font-size:12px;">Today's Activity</div>
        </div>
    </div>
    <div class="audit-stat-card">
        <div class="audit-stat-icon icon-sky">👥</div>
        <div>
            <div class="dash-stat-num" style="font-size:24px; margin:0;">@Model.ActiveUsersCount</div>
            <div class="dash-stat-label" style="font-size:12px;">Active Users Logged</div>
        </div>
    </div>
    <div class="audit-stat-card">
        <div class="audit-stat-icon icon-grape">📋</div>
        <div>
            <div class="dash-stat-num" style="font-size:24px; margin:0;">@Model.FormActionsCount</div>
            <div class="dash-stat-label" style="font-size:12px;">Form Lifecycle Events</div>
        </div>
    </div>
</div>

<!-- ===== Main Panel ===== -->
<section class="dash-panel clay-card" style="padding: 26px 24px;">
    <div class="dash-panel-head">
        <div>
            <h2 style="margin:0; font-size:20px;">Audit History &amp; Event Logs</h2>
            <p class="dash-panel-sub" style="margin-top:4px;">Chronological trail of user authentications, administrative actions, and feedback form lifecycle modifications.</p>
        </div>
        <a asp-controller="AuditLogs" asp-action="Index" class="btn btn-ghost btn-sm" title="Refresh audit log feed">🔄 Refresh</a>
    </div>

    <!-- Filter Toolbar -->
    <form method="get" asp-controller="AuditLogs" asp-action="Index" class="audit-filters-form">
        <div class="clay-search-wrapper" style="flex: 1; min-width: 220px;">
            <span class="search-icon">&#128269;</span>
            <input type="text" name="search" value="@Model.SearchQuery" placeholder="Search by user, action, details..." class="clay-input" />
        </div>

        <select name="actionType" class="clay-select" style="min-width: 160px;">
            <option value="">All Action Types</option>
            @foreach (var act in Model.ActionTypes)
            {
                <option value="@act" selected="@(Model.SelectedAction == act ? "selected" : null)">@act</option>
            }
        </select>

        <select name="entityName" class="clay-select" style="min-width: 150px;">
            <option value="">All Entities</option>
            @foreach (var ent in Model.EntityTypes)
            {
                <option value="@ent" selected="@(Model.SelectedEntity == ent ? "selected" : null)">@ent</option>
            }
        </select>

        <button type="submit" class="btn btn-secondary btn-sm" style="padding: 10px 18px;">Filter</button>
        @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedAction) || !string.IsNullOrEmpty(Model.SelectedEntity) || Model.StartDate.HasValue || Model.EndDate.HasValue)
        {
            <a asp-controller="AuditLogs" asp-action="Index" class="dash-panel-link" style="font-weight:700; font-size:13px;">Clear</a>
        }
    </form>

    <!-- Logs Table -->
    @if (!Model.Logs.Any())
    {
        <div style="text-align: center; padding: 48px 20px; background: var(--clay-soft); border-radius: var(--radius-md);">
            <span style="font-size: 36px; display: block; margin-bottom: 10px;">📜</span>
            <p class="dash-empty">No audit logs found matching your criteria.</p>
            <p style="font-size: 12.5px; color: var(--ink-faint); margin: 0;">Logs will populate automatically as users log in, manage forms, or submit responses.</p>
        </div>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th style="width: 160px;">Timestamp</th>
                        <th style="width: 200px;">User</th>
                        <th style="width: 150px;">Action</th>
                        <th style="width: 140px;">Entity</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        string actionClass = "action-default";
                        string actLower = log.Action.ToLower();
                        if (actLower.Contains("login") || actLower.Contains("auth")) actionClass = "action-login";
                        else if (actLower.Contains("create") || actLower.Contains("register") || actLower.Contains("add")) actionClass = "action-create";
                        else if (actLower.Contains("update") || actLower.Contains("toggle") || actLower.Contains("edit")) actionClass = "action-update";
                        else if (actLower.Contains("publish")) actionClass = "action-publish";
                        else if (actLower.Contains("close")) actionClass = "action-close";
                        else if (actLower.Contains("delete") || actLower.Contains("remove")) actionClass = "action-delete";

                        string userInitials = !string.IsNullOrWhiteSpace(log.UserName)
                            ? string.Join("", log.UserName.Split(' ').Take(2).Select(s => s.FirstOrDefault().ToString())).ToUpper()
                            : "SY";

                        <tr>
                            <td style="font-size: 12px; color: var(--ink-soft); white-space: nowrap;">
                                <strong>@log.CreatedAt.ToString("dd MMM yyyy")</strong><br />
                                <span style="color: var(--ink-faint); font-size: 11px;">@log.CreatedAt.ToString("hh:mm:ss tt")</span>
                            </td>
                            <td>
                                @if (log.UserId.HasValue && !string.IsNullOrEmpty(log.UserName))
                                {
                                    <div class="user-chip-mini">
                                        <div class="user-avatar-mini">@userInitials</div>
                                        <div>
                                            <div style="font-weight: 700; font-size: 13px; color: var(--ink);">@log.UserName</div>
                                            <div style="font-size: 11px; color: var(--ink-faint);">
                                                @(string.IsNullOrEmpty(log.RoleName) ? log.UserEmail : $"{log.RoleName} • {log.UserEmail}")
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="user-chip-mini">
                                        <div class="user-avatar-mini" style="background:#EAEBF7; color:var(--ink-soft);">SYS</div>
                                        <div>
                                            <div style="font-weight: 700; font-size: 13px; color: var(--ink-soft);">System / Anonymous</div>
                                            <div style="font-size: 11px; color: var(--ink-faint);">Guest event</div>
                                        </div>
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="action-badge @actionClass">
                                    @log.Action
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.EntityName))
                                {
                                    <span class="entity-chip">
                                        @log.EntityName@(log.EntityId.HasValue ? $" #{log.EntityId}" : "")
                                    </span>
                                }
                                else
                                {
                                    <span style="color: var(--ink-faint); font-size: 12px;">&mdash;</span>
                                }
                            </td>
                            <td style="font-size: 13px; color: var(--ink-soft); max-width: 360px;">
                                @(string.IsNullOrWhiteSpace(log.Details) ? "No additional details provided." : log.Details)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
